<mujoco model="nav_test">
  <!-- 8 x 6 m room (x -2..6, y -3..3) split by a partition with a 1.5 m doorway. The robot
       starts at the origin, yaw 0. Only the first root body is attached to the scene.
       maps/nav_test.* is generated from this file by scripts/world_to_map.py. -->
  <default>
    <geom type="box" contype="1" conaffinity="1" rgba="0.72 0.7 0.66 1"/>
    <default class="obstacle">
      <geom rgba="0.85 0.45 0.15 1"/>
    </default>
  </default>
  <worldbody>
    <body name="nav_test">
      <geom name="wall_south" pos="2 -3.05 0.5" size="4.1 0.05 0.5"/>
      <geom name="wall_north" pos="2 3.05 0.5" size="4.1 0.05 0.5"/>
      <geom name="wall_west" pos="-2.05 0 0.5" size="0.05 3 0.5"/>
      <geom name="wall_east" pos="6.05 0 0.5" size="0.05 3 0.5"/>
      <geom name="partition_south" pos="3.5 -1.25 0.5" size="0.05 1.75 0.5"/>
      <geom name="partition_north" pos="3.5 2.5 0.5" size="0.05 0.5 0.5"/>
      <geom name="box_front" class="obstacle" pos="1.3 0 0.5" size="0.25 0.4 0.5"/>
      <geom name="box_skewed" class="obstacle" pos="0 -2 0.5" size="0.4 0.2 0.5"
            quat="0.965926 0 0 0.258819"/>
      <geom name="pillar_west" class="obstacle" type="cylinder" pos="-1 1.8 0.5"
            size="0.3 0.5"/>
      <geom name="box_room2" class="obstacle" pos="4.8 1.9 0.5" size="0.3 0.3 0.5"/>
      <geom name="pillar_room2" class="obstacle" type="cylinder" pos="4.6 -0.4 0.5"
            size="0.25 0.5"/>
    </body>
  </worldbody>
</mujoco>
